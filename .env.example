# Optional: use a full URL when the API is hosted on a separate origin.
# The default is /api/contact, proxied to the local Express server during development.
VITE_CONTACT_ENDPOINT=/api/contact

# Server-only SMTP settings. Copy this file to .env and fill these in; never use VITE_ prefixes.
PORT=3001
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=info@alsvidinfo.com

# Optional comma-separated browser origins if the API is hosted separately.
CONTACT_ALLOWED_ORIGINS=

# Set to the number of trusted reverse proxies in front of the server (usually 1).
TRUST_PROXY=0
